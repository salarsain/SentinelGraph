# ============================================================
# SentinelGraph — Environment Configuration
# ============================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=SentinelGraph
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=CHANGE_ME_generate_32_byte_key_base64

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_USER=sentinelgraph
POSTGRES_PASSWORD=sentinelgraph_dev_password
POSTGRES_DB=sentinelgraph
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentinelgraph:sentinelgraph_dev_password@postgres:5432/sentinelgraph

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── MinIO (Object Storage) ───────────────────────────────────
MINIO_ROOT_USER=sentinelgraph
MINIO_ROOT_PASSWORD=sentinelgraph_minio_dev
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=sentinelgraph-evidence
MINIO_USE_SSL=false

# ── AI / Hugging Face ────────────────────────────────────────
# Modes: "rule_based" (no API needed), "huggingface_api" (free), "local_transformers"
AI_MODE=rule_based
HF_API_TOKEN=hf_your_token_here   # Get free token at: huggingface.co/settings/tokens
HF_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3
HF_LOCAL_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# ── Scanning Defaults ────────────────────────────────────────
MAX_CONCURRENT_SCANS=5
MAX_CRAWL_DEPTH=10
MAX_REQUESTS_PER_SECOND=10
DEFAULT_REQUEST_TIMEOUT=30
MAX_RESPONSE_SIZE_MB=10
USER_AGENT=SentinelGraph/0.1.0 (Security Assessment)

# ── Nginx ────────────────────────────────────────────────────
NGINX_PORT=80
NGINX_SSL_PORT=443
